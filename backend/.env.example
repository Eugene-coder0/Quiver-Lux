# Local development configuration. Copy this file to .env and set DATABASE_URL
# to a local PostgreSQL database before starting the API.
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-local-development-secret
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/quiver_lux?schema=public
ALLOWED_ORIGINS=http://127.0.0.1:61198,http://localhost:61198

# The placeholder keeps checkout in safe mock mode: no real Paystack charge is created.
PAYSTACK_SECRET_KEY=sk_test_placeholder
ALLOW_TEST_PAYSTACK_BYPASS=true

# Optional local placeholder values for image uploads.
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=secret
